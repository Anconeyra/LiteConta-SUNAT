{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckUrl": "/",
    "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT"
  },
  "variables": {
    "APP_NAME": "LiteConta-SUNAT",
    "APP_ENV": "production",
    "APP_KEY": "base64:TuClaveGeneradaAquí12345678901234567890123456=",
    "APP_DEBUG": "false",
    "APP_URL": "https://liteconta-sunat-production.up.railway.app",
    "APP_LOCALE": "es",
    "APP_FALLBACK_LOCALE": "es",
    "APP_FAKER_LOCALE": "es_ES",
    "PHP_CLI_SERVER_WORKERS": "4",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "${{MYSQLHOST}}",
    "DB_PORT": "${{MYSQLPORT}}",
    "DB_DATABASE": "${{MYSQLDATABASE}}",
    "DB_USERNAME": "${{MYSQLUSER}}",
    "DB_PASSWORD": "${{MYSQLPASSWORD}}",
    "BROADCAST_DRIVER": "log",
    "CACHE_DRIVER": "redis",
    "FILESYSTEM_DISK": "local",
    "QUEUE_CONNECTION": "redis",
    "SESSION_DRIVER": "redis",
    "SESSION_LIFETIME": "120",
    "REDIS_HOST": "redis.railway.internal",
    "REDIS_PASSWORD": "null",
    "REDIS_PORT": "6379",
    "MAIL_MAILER": "smtp",
    "MAIL_HOST": "smtp.mailgun.org",
    "MAIL_PORT": "587",
    "MAIL_USERNAME": "",
    "MAIL_PASSWORD": "",
    "MAIL_ENCRYPTION": "tls",
    "MAIL_FROM_ADDRESS": "hello@example.com",
    "MAIL_FROM_NAME": "${APP_NAME}",
    "APIS_PERU_TOKEN": ""
  }
}